{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "app/api/cron/telegram-reports/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/ping",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/verify-payments",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/sms-dispatch",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/sms-dlr",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/media-purge",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/auth-attempts-ttl",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/telegram-dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/telegram-reports",
      "schedule": "5 * * * *"
    }
  ]
}
