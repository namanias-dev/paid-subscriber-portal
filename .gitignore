.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Word temp/lock files
~$*

# Local DB backups (contain PII — never commit)
/backups/

# Ephemeral screenshot dumps (never trigger builds)
.tmp-screenshots/

# Legacy-migration service-account credentials (Google Sheets read).
# Do NOT commit — the operator sets GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON in Vercel env,
# or passes --service-account-path=<file> as an ephemeral local input for the dry-run.
credentials/
service_account*.json

# Local Gmail OTP helper (desktop OAuth). Never deploy, never commit secrets.
scripts/local/shipping-gmail-otp/.venv/
scripts/local/shipping-gmail-otp/__pycache__/
scripts/local/shipping-gmail-otp/client_secret.json
scripts/local/shipping-gmail-otp/token.json
scripts/local/shipping-gmail-otp/*.token.json

